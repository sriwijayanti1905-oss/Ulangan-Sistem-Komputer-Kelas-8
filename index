            points: 5,
            image: "",
            text: "Berikan, kesan/pesan/masukanmu/kendala terkait pembelajaran ini!",
            options: [],
            correct: null
        },
    ];

    // ================= STATE UJIAN =================
    let currentStudent = null;
    let currentQuestionIndex = 0;
    let userAnswers = {};
    let flaggedQuestions = {};
    let fraudCount = 0;
    let remainingSeconds = examConfig.durationSeconds;
    let timerInterval = null;
    let isExamActive = false;
    let submissions = [];

    document.addEventListener("DOMContentLoaded", () => {
        updateLobbyDisplay();
        renderTeacherQuestions();
    });

    function updateLobbyDisplay() {
        const mins = Math.floor(examConfig.durationSeconds / 60);
        document.getElementById("activeBankTitleDisplay").textContent = examConfig.title;
        document.getElementById("activeBankTimerBadge").textContent = `${mins} Menit`;
        document.getElementById("examDurationMinutesInput").value = mins;
        document.getElementById("reflectionLinkInput").value = examConfig.reflectionUrl;
        document.getElementById("scriptUrlInput").value = GOOGLE_SCRIPT_URL;
    }

    // ================= SISTEM ANTI-CHEAT =================
    document.addEventListener("visibilitychange", () => {
        if (document.hidden && isExamActive) {
            fraudCount++;
            document.getElementById("fraudCountBadge").textContent = `Terdeteksi Curang: ${fraudCount} Kali`;
            document.getElementById("cheatWarningCounterText").textContent = `Total Pelanggaran: ${fraudCount} Kali`;
            document.getElementById("antiCheatModal").classList.remove("hidden");
        }
    });

    function dismissAntiCheatModal() {
        document.getElementById("antiCheatModal").classList.add("hidden");
    }

    function handleProceedToBriefing(e) {
        e.preventDefault();
        const name = document.getElementById("studentName").value.trim();
        const studentClass = document.getElementById("studentClass").value;
        const dob = document.getElementById("studentDob").value;

        if (!name || !studentClass || !dob) return;

        currentStudent = { name, studentClass, dob };

        document.getElementById("identityView").classList.add("hidden");
        document.getElementById("briefingView").classList.remove("hidden");
    }

    function startActualExam() {
        currentQuestionIndex = 0;
        userAnswers = {};
        flaggedQuestions = {};
        fraudCount = 0;
        remainingSeconds = examConfig.durationSeconds;
        isExamActive = true;

        document.getElementById("fraudCountBadge").textContent = `Terdeteksi Curang: 0 Kali`;
        document.getElementById("briefingView").classList.add("hidden");
        document.getElementById("resultsView").classList.add("hidden");
        document.getElementById("examView").classList.remove("hidden");

        startGlobalTimer();
        renderCurrentQuestion();
    }

    function startGlobalTimer() {
        clearInterval(timerInterval);
        updateTimerUI();

        timerInterval = setInterval(() => {
            remainingSeconds--;
            updateTimerUI();

            if (remainingSeconds <= 0) {
                clearInterval(timerInterval);
                alert("WAKTU HABIS! Jawaban Anda otomatis dikirimkan ke sistem.");
                submitExam();
            }
        }, 1000);
    }

    function updateTimerUI() {
        const mins = Math.floor(remainingSeconds / 60);
        const secs = remainingSeconds % 60;
        const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        const display = document.getElementById("timerDisplay");
        display.textContent = formatted;

        if (remainingSeconds <= 60) {
            display.classList.add("timer-warning");
        } else {
            display.classList.remove("timer-warning");
        }
    }

    function renderCurrentQuestion() {
        const q = questionBank[currentQuestionIndex];
        const total = questionBank.length;

        document.getElementById("currentQuestionNum").textContent = currentQuestionIndex + 1;
        document.getElementById("totalQuestionsNum").textContent = total;
        document.getElementById("questionPointBadge").textContent = `${q.points} Poin`;
        document.getElementById("questionCategoryBadge").textContent = q.type === "mc" ? "Pilihan Ganda" : "Essay / Uraian";
        document.getElementById("questionText").textContent = q.text;

        const imgWrapper = document.getElementById("questionImageWrapper");
        const imgEl = document.getElementById("questionImage");
        if (q.image && q.image.trim() !== "") {
            imgEl.src = q.image.trim();
            imgWrapper.classList.remove("hidden");
        } else {
            imgEl.src = "";
            imgWrapper.classList.add("hidden");
        }

        const optionsList = document.getElementById("optionsList");
        const essayArea = document.getElementById("essayArea");
        optionsList.innerHTML = "";

        if (q.type === "mc") {
            optionsList.classList.remove("hidden");
            essayArea.classList.add("hidden");
            const letters = ["A", "B", "C", "D"];

            q.options.forEach((opt, idx) => {
                const isSelected = userAnswers[q.id] === idx;
                const btn = document.createElement("button");
                btn.type = "button";
                btn.onclick = () => selectMcOption(q.id, idx);
                btn.className = `w-full text-left p-3.5 rounded-xl border transition-all flex items-center space-x-3 ${
                    isSelected
                        ? "bg-mlgold-500/20 border-mlgold-400 text-mlgold-200 shadow-md shadow-mlgold-500/15"
                        : "bg-mldark-900/90 border-mldark-600 hover:border-mlgold-500/50 text-slate-200"
                }`;
                btn.innerHTML = `
                    <span class="w-8 h-8 rounded-lg flex items-center justify-center font-orbitron font-bold text-xs ${
                        isSelected ? "bg-mlgold-400 text-mldark-900" : "bg-mldark-700 text-mlgold-300"
                    }">${letters[idx]}</span>
                    <span class="text-sm font-medium">${opt}</span>
                `;
                optionsList.appendChild(btn);
            });
        } else {
            optionsList.classList.add("hidden");
            essayArea.classList.remove("hidden");
            document.getElementById("essayInput").value = userAnswers[q.id] || "";
        }

        const isFlagged = !!flaggedQuestions[q.id];
        document.getElementById("flagQuestionIcon").className = isFlagged ? "fa-solid fa-bookmark text-xs" : "fa-regular fa-bookmark text-xs";
        document.getElementById("flagQuestionText").textContent = isFlagged ? "DITANDAI RAGU" : "RAGU-RAGU";

        document.getElementById("prevQuestionBtn").disabled = currentQuestionIndex === 0;
        document.getElementById("prevQuestionBtn").classList.toggle("opacity-40", currentQuestionIndex === 0);

        if (currentQuestionIndex === total - 1) {
            document.getElementById("nextQuestionBtn").classList.add("hidden");
            document.getElementById("finishExamTriggerBtn").classList.remove("hidden");
        } else {
            document.getElementById("nextQuestionBtn").classList.remove("hidden");
            document.getElementById("finishExamTriggerBtn").classList.add("hidden");
        }

        setQuestionViewMode("question");
        renderNavigationStrips();
    }

    function setQuestionViewMode(mode) {
        const qContainer = document.getElementById("questionContainer");
        const oContainer = document.getElementById("optionsContainer");
        const btnQ = document.getElementById("toggleQuestionBtn");
        const btnO = document.getElementById("toggleOptionsBtn");

        if (mode === "question") {
            qContainer.classList.remove("hidden");
            oContainer.classList.add("hidden");
            btnQ.className = "flex-1 py-2 px-4 rounded-lg font-rajdhani font-bold text-xs sm:text-sm transition-all bg-gradient-to-r from-mlgold-600 to-mlgold-500 text-mldark-900 flex items-center justify-center space-x-2 shadow-md";
            btnO.className = "flex-1 py-2 px-4 rounded-lg font-rajdhani font-bold text-xs sm:text-sm transition-all bg-mldark-800 text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-2";
        } else {
            qContainer.classList.add("hidden");
            oContainer.classList.remove("hidden");
            btnO.className = "flex-1 py-2 px-4 rounded-lg font-rajdhani font-bold text-xs sm:text-sm transition-all bg-gradient-to-r from-mlgold-600 to-mlgold-500 text-mldark-900 flex items-center justify-center space-x-2 shadow-md";
            btnQ.className = "flex-1 py-2 px-4 rounded-lg font-rajdhani font-bold text-xs sm:text-sm transition-all bg-mldark-800 text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-2";
        }
    }

    function selectMcOption(qId, optIdx) {
        userAnswers[qId] = optIdx;
        renderCurrentQuestion();
        setQuestionViewMode("question");
    }

    function saveCurrentEssayAnswer() {
        const q = questionBank[currentQuestionIndex];
        userAnswers[q.id] = document.getElementById("essayInput").value;
        renderNavigationStrips();
    }

    function toggleFlagCurrentQuestion() {
        const q = questionBank[currentQuestionIndex];
        flaggedQuestions[q.id] = !flaggedQuestions[q.id];
        renderCurrentQuestion();
    }

    function navigateGlobalPrev() {
        if (currentQuestionIndex > 0) {
            currentQuestionIndex--;
            renderCurrentQuestion();
        }
    }

    function navigateGlobalNext() {
        if (currentQuestionIndex < questionBank.length - 1) {
            currentQuestionIndex++;
            renderCurrentQuestion();
        }
    }

    function jumpToQuestion(idx) {
        currentQuestionIndex = idx;
        renderCurrentQuestion();
        document.getElementById("questionPaletteModal").classList.add("hidden");
    }

    function renderNavigationStrips() {
        const strip = document.getElementById("inlineNavStrip");
        const modalGrid = document.getElementById("modalPaletteGrid");
        strip.innerHTML = "";
        modalGrid.innerHTML = "";

        let answeredCount = 0;

        questionBank.forEach((q, idx) => {
            const ans = userAnswers[q.id];
            const isAnswered = ans !== undefined && ans !== null && String(ans).trim() !== "";
            if (isAnswered) answeredCount++;

            const isCurrent = idx === currentQuestionIndex;
            const isFlagged = !!flaggedQuestions[q.id];

            let colorClass = "bg-mldark-800 border-mldark-600 text-slate-300";
            if (isCurrent) {
                colorClass = "bg-mlgold-400 border-mlgold-300 text-mldark-900 font-black";
            } else if (isFlagged) {
                colorClass = "bg-amber-500/80 border-amber-400 text-mldark-900 font-bold";
            } else if (isAnswered) {
                colorClass = "bg-emerald-500/80 border-emerald-400 text-mldark-900 font-bold";
            }

            const btn1 = document.createElement("button");
            btn1.className = `w-8 h-8 rounded-lg border text-xs font-orbitron flex-shrink-0 transition-all ${colorClass}`;
            btn1.textContent = idx + 1;
            btn1.onclick = () => jumpToQuestion(idx);
            strip.appendChild(btn1);

            const btn2 = document.createElement("button");
            btn2.className = `h-10 rounded-lg border text-xs font-orbitron transition-all ${colorClass}`;
            btn2.textContent = idx + 1;
            btn2.onclick = () => jumpToQuestion(idx);
            modalGrid.appendChild(btn2);
        });

        document.getElementById("answeredStatsText").textContent = `Terjawab: ${answeredCount} / ${questionBank.length}`;
    }

    function openImageZoomModal(src) {
        if (!src) return;
        document.getElementById("zoomedImageTarget").src = src;
        document.getElementById("imageZoomModal").classList.remove("hidden");
    }

    function closeImageZoomModal() {
        document.getElementById("imageZoomModal").classList.add("hidden");
    }

    function handleImageLoadError(imgEl) {
        imgEl.src = "https://via.placeholder.com/600x300/121824/f2c94c?text=Gambar+Tidak+Dapat+Dimuat+(Periksa+Link+URL)";
    }

    function promptFinishConfirmation() {
        if (confirm("Apakah Anda yakin ingin mengakhiri arena dan mengirimkan jawaban?")) {
            submitExam();
        }
    }

    function submitExam() {
        isExamActive = false;
        clearInterval(timerInterval);

        let objectiveScore = 0;
        let maxObjectiveScore = 0;
        let essayAnswerText = "-";

        questionBank.forEach(q => {
            if (q.type === "mc") {
                maxObjectiveScore += q.points;
                if (userAnswers[q.id] === q.correct) {
                    objectiveScore += q.points;
                }
            } else if (q.type === "essay") {
                essayAnswerText = userAnswers[q.id] || "(Tidak dijawab)";
            }
        });

        const submissionData = {
            nama: currentStudent.name,
            kelas: currentStudent.studentClass,
            tanggalLahir: currentStudent.dob,
            materi: examConfig.title,
            skorObjektif: objectiveScore,
            maxSkor: maxObjectiveScore,
            jumlahCurang: fraudCount,
            jawabanEssay: essayAnswerText,
            waktuKirim: new Date().toISOString()
        };

        submissions.push({
            student: currentStudent,
            objectiveScore,
            maxObjectiveScore,
            essayAnswer: essayAnswerText,
            fraudCount
        });

        // KIRIM DATA KE GOOGLE SHEETS VIA APPS SCRIPT
        kirimDataKeGoogleSheets(submissionData);

        document.getElementById("examView").classList.add("hidden");
        document.getElementById("resultsView").classList.remove("hidden");

        document.getElementById("studentResultGreeting").textContent = `VICTORY, ${currentStudent.name} (${currentStudent.studentClass})!`;
        document.getElementById("scoreDisplay").textContent = `${objectiveScore}/${maxObjectiveScore}`;
        document.getElementById("studentReflectionBtn").href = examConfig.reflectionUrl;
    }

    function downloadReport() {
        const last = submissions[submissions.length - 1];
        if (!last) return;
        const content = `BUKTI HASIL ASESMEN ARENA TIK (MOBILE LEGENDS EDITION)\n====================================================\nNama Siswa   : ${last.student.name}\nKelas        : ${last.student.studentClass}\nMateri       : ${examConfig.title}\nSkor Objektif: ${last.objectiveScore} / ${last.maxObjectiveScore}\nLog Curang   : ${last.fraudCount} Kali\nJawaban Essay: ${last.essayAnswer}\n`;
        const blob = new Blob([content], { type: "text/plain" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `Hasil_TIK_${last.student.name.replace(/\s+/g, '_')}.txt`;
        a.click();
    }

    function resetToIdentity() {
        document.getElementById("resultsView").classList.add("hidden");
        document.getElementById("identityView").classList.remove("hidden");
        document.getElementById("studentAuthForm").reset();
    }

    // ================= PANEL GURU =================
    function toggleQuestionPaletteModal() {
        document.getElementById("questionPaletteModal").classList.toggle("hidden");
    }

    function toggleTeacherAuthModal() {
        document.getElementById("teacherAuthModal").classList.toggle("hidden");
    }

    function verifyTeacherPin() {
        const pin = document.getElementById("teacherPinInput").value;
        if (pin === "1234") {
            document.getElementById("teacherPinInput").value = "";
            toggleTeacherAuthModal();
            document.getElementById("identityView").classList.add("hidden");
            document.getElementById("briefingView").classList.add("hidden");
            document.getElementById("examView").classList.add("hidden");
            document.getElementById("resultsView").classList.add("hidden");
            document.getElementById("teacherPanel").classList.remove("hidden");
            renderTeacherQuestions();
            renderTeacherSubmissions();
        } else {
            alert("PIN Guru salah! Gunakan PIN default: 1234");
        }
    }

    function exitTeacherPanel() {
        document.getElementById("teacherPanel").classList.add("hidden");
        document.getElementById("identityView").classList.remove("hidden");
    }

    function switchTeacherTab(tab) {
        ["questions", "submissions", "fraud"].forEach(t => {
            document.getElementById(`tab${t.charAt(0).toUpperCase() + t.slice(1)}`).classList.add("hidden");
            document.getElementById(`tabBtn${t.charAt(0).toUpperCase() + t.slice(1)}`).className = "py-2.5 px-4 font-rajdhani font-bold text-sm border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-all whitespace-nowrap";
        });
        document.getElementById(`tab${tab.charAt(0).toUpperCase() + tab.slice(1)}`).classList.remove("hidden");
        document.getElementById(`tabBtn${tab.charAt(0).toUpperCase() + tab.slice(1)}`).className = "py-2.5 px-4 font-rajdhani font-bold text-sm border-b-2 border-mlgold-400 text-mlgold-300 transition-all whitespace-nowrap";
    }

    function updateExamDuration() {
        const mins = parseInt(document.getElementById("examDurationMinutesInput").value, 10);
        if (mins && mins > 0) {
            examConfig.durationSeconds = mins * 60;
            updateLobbyDisplay();
            alert(`Durasi ujian berhasil diperbarui menjadi ${mins} menit!`);
        }
    }

    function updateScriptUrl() {
        const url = document.getElementById("scriptUrlInput").value.trim();
        if (url) {
            GOOGLE_SCRIPT_URL = url;
            alert("Google Apps Script URL berhasil diperbarui!");
        }
    }

    function updateReflectionLink() {
        const url = document.getElementById("reflectionLinkInput").value.trim();
        if (url) {
            examConfig.reflectionUrl = url;
            alert("Link Refleksi Siswa berhasil diperbarui!");
        }
    }

    function toggleNewQTypeFields() {
        const type = document.getElementById("newQType").value;
        document.getElementById("newQOptionsSection").classList.toggle("hidden", type === "essay");
    }

    function previewNewQuestionImage(url) {
        const box = document.getElementById("newQImagePreviewBox");
        const img = document.getElementById("newQImagePreview");
        if (url && url.trim() !== "") {
            img.src = url.trim();
            box.classList.remove("hidden");
        } else {
            box.classList.add("hidden");
        }
    }

    function handleAddQuestion(e) {
        e.preventDefault();
        const type = document.getElementById("newQType").value;
        const points = parseInt(document.getElementById("newQPoints").value, 10) || 10;
        const image = document.getElementById("newQImage").value.trim();
        const text = document.getElementById("newQText").value.trim();

        let options = [];
        let correct = null;

        if (type === "mc") {
            options = [
                document.getElementById("newQOpt0").value.trim() || "Opsi A",
                document.getElementById("newQOpt1").value.trim() || "Opsi B",
                document.getElementById("newQOpt2").value.trim() || "Opsi C",
                document.getElementById("newQOpt3").value.trim() || "Opsi D"
            ];
            correct = parseInt(document.getElementById("newQCorrect").value, 10);
        }

        questionBank.push({
            id: Date.now(),
            type,
            points,
            image,
            text,
            options,
            correct
        });

        e.target.reset();
        document.getElementById("newQImagePreviewBox").classList.add("hidden");
        toggleNewQTypeFields();
        renderTeacherQuestions();
        alert("Soal baru berhasil ditambahkan ke Bank Soal!");
    }

    function deleteQuestion(id) {
        if (questionBank.length <= 1) {
            alert("Minimal harus ada 1 soal di dalam bank soal!");
            return;
        }
        questionBank = questionBank.filter(q => q.id !== id);
        renderTeacherQuestions();
    }

    function renderTeacherQuestions() {
        const container = document.getElementById("teacherQuestionsList");
        document.getElementById("teacherQCount").textContent = questionBank.length;
        container.innerHTML = "";

        questionBank.forEach((q, idx) => {
            const div = document.createElement("div");
            div.className = "p-4 bg-mldark-900/90 rounded-xl border border-mldark-600 flex flex-col sm:flex-row justify-between gap-3";
            div.innerHTML = `
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 bg-mlgold-500/20 text-mlgold-300 rounded text-xs font-orbitron font-bold">#${idx + 1}</span>
                        <span class="text-xs text-slate-400 font-rajdhani uppercase">${q.type === 'mc' ? 'Pilihan Ganda' : 'Essay'} • ${q.points} Poin</span>
                        ${q.image ? '<span class="px-2 py-0.5 bg-blue-500/20 text-blue-300 rounded text-[10px] font-bold"><i class="fa-solid fa-image mr-1"></i>Bergambar</span>' : ''}
                    </div>
                    <p class="text-sm text-slate-200">${q.text}</p>
                    ${q.image ? `<p class="text-[11px] text-mlgold-400 truncate max-w-md">Link Gambar: ${q.image}</p>` : ''}
                </div>
                <button onclick="deleteQuestion(${q.id})" class="self-start px-3 py-1.5 bg-red-950/60 hover:bg-red-900 text-red-300 border border-red-500/40 rounded-lg text-xs font-rajdhani font-bold">
                    <i class="fa-solid fa-trash"></i> Hapus
                </button>
            `;
            container.appendChild(div);
        });
    }

    function renderTeacherSubmissions() {
        const tbody = document.getElementById("studentSubmissionsTable");
        const fraudTbody = document.getElementById("fraudTable");
        document.getElementById("submissionCount").textContent = `Total: ${submissions.length} Siswa`;
        tbody.innerHTML = "";
        fraudTbody.innerHTML = "";

        submissions.forEach(sub => {
            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td class="p-3 font-semibold text-slate-200">${sub.student.name}</td>
                <td class="p-3 text-slate-300">${sub.student.studentClass}</td>
                <td class="p-3">${sub.fraudCount > 0 ? `<span class="text-amber-400 font-bold">${sub.fraudCount}x Keluar</span>` : '<span class="text-emerald-400">Aman</span>'}</td>
                <td class="p-3 font-orbitron font-bold text-mlgold-300">${sub.objectiveScore}/${sub.maxObjectiveScore}</td>
                <td class="p-3 text-xs text-slate-300 max-w-xs">${sub.essayAnswer}</td>
            `;
            tbody.appendChild(tr);

            if (sub.fraudCount > 0) {
                const ftr = document.createElement("tr");
                ftr.innerHTML = `
                    <td class="p-3 font-semibold text-slate-200">${sub.student.name}</td>
                    <td class="p-3 text-slate-300">${sub.student.studentClass}</td>
                    <td class="p-3 text-amber-400 font-bold">${sub.fraudCount} Kali</td>
                    <td class="p-3"><span class="px-2 py-0.5 bg-red-500/20 text-red-300 rounded text-xs">Terdeteksi</span></td>
                `;
                fraudTbody.appendChild(ftr);
            }
        });
    }
</script>
</body>
</html>
