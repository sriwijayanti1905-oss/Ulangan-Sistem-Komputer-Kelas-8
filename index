<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assessment Arena - TIK Kelas 8 (MLBB Edition + Apps Script)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Orbitron & Rajdhani for Gaming Vibe -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800;900&family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    mlgold: {
                        300: '#fce085',
                        400: '#f2c94c',
                        500: '#e0a926',
                        600: '#c28b17',
                    },
                    mldark: {
                        900: '#0b0e14',
                        800: '#121824',
                        700: '#1a2235',
                        600: '#253147',
                    },
                    mlblue: {
                        400: '#00d2ff',
                        500: '#0088ff',
                        600: '#0055ff',
                    }
                },
                fontFamily: {
                    sans: ['Inter', 'sans-serif'],
                    orbitron: ['Orbitron', 'sans-serif'],
                    rajdhani: ['Rajdhani', 'sans-serif'],
                }
            }
        }
    }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0e14;
            color: #e2e8f0;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            background-image: 
                radial-gradient(circle at 50% 0%, rgba(224, 169, 38, 0.12) 0%, #0b0e14 70%),
                linear-gradient(rgba(242, 201, 76, 0.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(242, 201, 76, 0.025) 1px, transparent 1px);
            background-size: 100% 100%, 32px 32px, 32px 32px;
        }

        input, textarea, select {
            -webkit-user-select: text !important;
            -moz-user-select: text !important;
            -ms-user-select: text !important;
            user-select: text !important;
        }

        .ml-card {
            background: linear-gradient(135deg, rgba(26, 34, 53, 0.92) 0%, rgba(18, 24, 36, 0.96) 100%);
            border: 1px solid rgba(224, 169, 38, 0.35);
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.6), inset 0 0 18px rgba(242, 201, 76, 0.1);
        }

        .protected-text {
            position: relative;
            background-image: radial-gradient(#253147 1px, transparent 1px);
            background-size: 14px 14px;
        }

        .protected-text::after {
            content: "LAND OF DAWN ASSESSMENT • RANKED MODE";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-12deg);
            font-size: 1rem;
            font-weight: 800;
            font-family: 'Orbitron', sans-serif;
            color: rgba(224, 169, 38, 0.05);
            pointer-events: none;
            white-space: nowrap;
        }

        @keyframes timerPulse {
            0% { opacity: 1; text-shadow: 0 0 12px #ef4444; }
            50% { opacity: 0.45; text-shadow: none; }
            100% { opacity: 1; text-shadow: 0 0 12px #ef4444; }
        }
        .timer-warning {
            animation: timerPulse 1s infinite;
            color: #ef4444 !important;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0e14;
        }
        ::-webkit-scrollbar-thumb {
            background: #c28b17;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #f2c94c;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col text-slate-200">

<header class="bg-mldark-800/90 border-b border-mlgold-500/35 sticky top-0 z-30 backdrop-blur-md shadow-lg shadow-black/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-mlgold-400 to-mlgold-600 text-mldark-900 flex items-center justify-center font-extrabold text-xl shadow-lg shadow-mlgold-500/30 border border-mlgold-300">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <h1 class="font-orbitron font-extrabold text-lg tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-mlgold-300 via-mlgold-400 to-mlblue-400">
                    ASESMENT ARENA TIK
                </h1>
                <span class="text-[10px] font-rajdhani font-bold tracking-widest text-mlgold-400 uppercase block -mt-1">
                    Mobile Legends Theme • Informatika Kelas 8
                </span>
            </div>
        </div>

        <div class="flex items-center space-x-3">
            <button id="teacherPanelNavBtn" onclick="toggleTeacherAuthModal()" class="px-3.5 py-1.5 rounded-lg border border-mlgold-500/50 text-mlgold-300 bg-mldark-700/80 hover:bg-mlgold-500/20 font-rajdhani font-bold text-sm tracking-wider transition-all flex items-center space-x-2 shadow-md">
                <i class="fa-solid fa-user-shield text-mlgold-400"></i>
                <span>PANEL GURU</span>
            </button>
        </div>
    </div>
</header>

<main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 flex-grow w-full">

    <!-- STUDENT IDENTITY VIEW -->
    <section id="identityView" class="block">
        <div class="max-w-lg mx-auto ml-card rounded-2xl border border-mlgold-500/40 overflow-hidden relative shadow-2xl">
            <div class="bg-gradient-to-r from-mldark-800 via-mldark-700 to-mldark-800 p-6 text-center border-b border-mlgold-500/30">
                <div class="inline-flex p-3.5 bg-mlgold-500/15 border border-mlgold-400/50 rounded-full mb-3 backdrop-blur-sm text-mlgold-400 shadow-lg shadow-mlgold-500/20">
                    <i class="fa-solid fa-gamepad text-3xl"></i>
                </div>
                <h2 class="font-orbitron text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-mlgold-300 to-mlgold-500">PRE-UJIAN LOBBY</h2>
                <p class="text-xs text-slate-400 mt-1 font-rajdhani font-semibold tracking-wider uppercase">Masukkan Identitasmu Sebelum Masuk Land of Dawn</p>
            </div>

            <form id="studentAuthForm" onsubmit="handleProceedToBriefing(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-rajdhani font-bold uppercase tracking-wider text-mlgold-400 mb-1">Materi Arena Ujian</label>
                    <div class="p-3 bg-mldark-900/90 border border-mlgold-500/30 rounded-xl text-slate-200 font-bold text-sm flex items-center justify-between shadow-inner">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-scroll text-mlgold-400"></i>
                            <span id="activeBankTitleDisplay" class="font-rajdhani text-base tracking-wide">Sistem Komputer</span>
                        </div>
                        <span id="activeBankTimerBadge" class="text-xs bg-mlgold-500/20 text-mlgold-300 border border-mlgold-400/40 px-2.5 py-0.5 rounded-md font-mono font-bold">13 Menit</span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-rajdhani font-bold uppercase tracking-wider text-slate-300 mb-1">Nama Lengkap Siswa</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-mlgold-400"><i class="fa-solid fa-user-ninja"></i></span>
                        <input type="text" id="studentName" required class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-mldark-900 border border-mldark-600 focus:border-mlgold-400 focus:ring-1 focus:ring-mlgold-400 text-slate-200 text-sm transition-all" placeholder="Contoh: Karana">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-rajdhani font-bold uppercase tracking-wider text-slate-300 mb-1">Kelas / Squad</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-mlgold-400"><i class="fa-solid fa-users-viewfinder"></i></span>
                            <select id="studentClass" required class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-mldark-900 border border-mldark-600 focus:border-mlgold-400 focus:ring-1 focus:ring-mlgold-400 text-slate-200 text-sm transition-all">
                                <option value="">Pilih Kelas</option>
                                <option value="VIII 1">VIII 1</option>
                                <option value="VIII 2">VIII 2</option>
                                <option value="VIII 3">VIII 3</option>
                                <option value="VIII 4">VIII 4</option>
                                <option value="VIII 5">VIII 5</option>
                                <option value="VIII 6">VIII 6</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-rajdhani font-bold uppercase tracking-wider text-slate-300 mb-1">Tanggal Lahir</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-mlgold-400"><i class="fa-solid fa-calendar-day"></i></span>
                            <input type="date" id="studentDob" required class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-mldark-900 border border-mldark-600 focus:border-mlgold-400 focus:ring-1 focus:ring-mlgold-400 text-slate-200 text-sm transition-all">
                        </div>
                    </div>
                </div>

                <button type="submit" class="w-full py-3 bg-gradient-to-r from-mlgold-600 via-mlgold-500 to-mlgold-400 hover:from-mlgold-500 hover:to-mlgold-300 text-mldark-900 font-orbitron font-black rounded-xl shadow-lg shadow-mlgold-500/25 transition-all flex items-center justify-center space-x-2 tracking-wider uppercase border border-mlgold-300">
                    <span>LANJUT</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>
        </div>
    </section>

    <!-- BRIEFING ARENA VIEW (JEDA ATURAN MAIN / PERATURAN) -->
    <section id="briefingView" class="hidden max-w-2xl mx-auto">
        <div class="ml-card rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl border-mlgold-400/50">
            <div class="text-center space-y-2">
                <div class="inline-flex p-4 rounded-full bg-mlgold-500/15 border border-mlgold-400 text-mlgold-400 text-4xl mb-1 shadow-lg shadow-mlgold-500/25">
                    <i class="fa-solid fa-scroll"></i>
                </div>
                <h2 class="font-orbitron text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-mlgold-300 via-mlgold-400 to-mlgold-500">BRIEFING PERATURAN ARENA</h2>
                <p class="text-xs text-slate-300 font-rajdhani uppercase tracking-wider">Harap baca dengan seksama sebelum memasuki Arena!</p>
            </div>

            <div class="space-y-3">
                <div class="p-4 bg-mldark-900/90 rounded-xl border border-red-500/30 flex items-start gap-3">
                    <div class="p-2 bg-red-500/20 text-red-400 rounded-lg text-lg"><i class="fa-solid fa-shield-cat"></i></div>
                    <div>
                        <h4 class="font-rajdhani font-bold text-red-300 text-sm uppercase">1. Anti-Cheat & Dilarang Pindah Tab</h4>
                        <p class="text-xs text-slate-300 mt-0.5">Sistem memonitor aktivitas browser Anda. Dilarang keras berpindah tab/window atau membuka aplikasi lain. Pelanggaran akan langsung memicu peringatan keras dan terekam di sistem Guru!</p>
                    </div>
                </div>

                <div class="p-4 bg-mldark-900/90 rounded-xl border border-mlgold-500/30 flex items-start gap-3">
                    <div class="p-2 bg-mlgold-500/20 text-mlgold-400 rounded-lg text-lg"><i class="fa-solid fa-book-open"></i></div>
                    <div>
                        <h4 class="font-rajdhani font-bold text-mlgold-300 text-sm uppercase">2. Baca Soal dengan Sungguh-Sungguh</h4>
                        <p class="text-xs text-slate-300 mt-0.5">Analisis setiap pertanyaan dan perhatikan gambar dengan teliti. Klik tombol "Pilihan Opsi Jawaban" untuk melihat pilihan dan memilih jawaban terbaik Anda.</p>
                    </div>
                </div>

                <div class="p-4 bg-mldark-900/90 rounded-xl border border-amber-500/30 flex items-start gap-3">
                    <div class="p-2 bg-amber-500/20 text-amber-400 rounded-lg text-lg"><i class="fa-solid fa-user-clock"></i></div>
                    <div>
                        <h4 class="font-rajdhani font-bold text-amber-300 text-sm uppercase">3. Anti-AFK & Perhatikan Waktu</h4>
                        <p class="text-xs text-slate-300 mt-0.5">Durasi total pertempuran adalah **13 menit**. Kelola waktu Anda dengan baik melalui Map Navigasi Soal agar tidak terkena hukuman AFK atau waktu habis.</p>
                    </div>
                </div>
            </div>

            <button onclick="startActualExam()" class="w-full py-3.5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-orbitron font-black rounded-xl shadow-lg transition-all flex items-center justify-center space-x-2 tracking-wider uppercase border border-emerald-400">
                <span>SIAP BERTANDING (START BATTLE)</span>
                <i class="fa-solid fa-check-double"></i>
            </button>
        </div>
    </section>

    <!-- EXAM SECTION VIEW -->
    <section id="examView" class="hidden space-y-4">
        <div class="ml-card rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center space-x-3">
                <span id="questionCategoryBadge" class="px-3 py-1 bg-mlgold-500/20 border border-mlgold-400/40 text-mlgold-300 rounded-lg text-xs font-rajdhani font-bold uppercase tracking-wider">
                    Pilihan Ganda
                </span>
                <span class="text-sm font-semibold text-slate-300 font-rajdhani">Soal <span id="currentQuestionNum" class="text-mlgold-400 font-bold text-base">1</span> dari <span id="totalQuestionsNum" class="text-slate-100 font-bold">5</span></span>
                <span id="questionPointBadge" class="px-2.5 py-0.5 bg-mlgold-500/20 border border-mlgold-400/40 text-mlgold-300 rounded-lg text-xs font-orbitron font-bold">20 Poin</span>
            </div>

            <div class="flex items-center space-x-3">
                <button id="navGridToggleBtn" onclick="toggleQuestionPaletteModal()" class="px-3.5 py-1.5 bg-mldark-900 border border-mlgold-500/40 hover:bg-mlgold-500/15 text-mlgold-300 rounded-xl text-xs font-rajdhani font-bold transition-all flex items-center gap-2">
                    <i class="fa-solid fa-grip text-mlgold-400"></i>
                    <span>MAP NAVIGASI</span>
                </button>
                <div class="flex items-center space-x-2 bg-mldark-900 px-3.5 py-1.5 rounded-xl border border-mlgold-500/40 shadow-inner">
                    <i class="fa-solid fa-stopwatch text-mlgold-400" id="timerIcon"></i>
                    <span id="timerDisplay" class="font-mono text-base font-bold text-mlgold-300">13:00</span>
                </div>
            </div>
        </div>

        <div id="fraudWarningBanner" class="bg-amber-950/40 border border-amber-500/40 rounded-xl p-3 text-amber-200 text-xs flex items-center justify-between backdrop-blur-sm">
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-shield-cat text-amber-400 text-base"></i>
                <span><strong class="font-rajdhani uppercase text-amber-400">Anti-Cheat Protection:</strong> Dilarang berpindah window/tab browser selama asesmen!</span>
            </div>
            <span class="bg-amber-500/20 border border-amber-400/40 px-2.5 py-1 rounded-lg font-bold font-mono text-amber-300" id="fraudCountBadge">Terdeteksi Curang: 0 Kali</span>
        </div>

        <div class="ml-card p-3 rounded-2xl space-y-2">
            <div class="flex items-center justify-between text-xs font-rajdhani font-bold text-slate-400 tracking-wider">
                <span class="flex items-center gap-1.5 uppercase text-mlgold-400"><i class="fa-solid fa-compass"></i> Fast Quest Strip</span>
                <span id="answeredStatsText" class="text-slate-400 font-medium font-mono text-[11px]">Terjawab: 0 / 0</span>
            </div>
            <div id="inlineNavStrip" class="flex items-center gap-1.5 overflow-x-auto pb-1 pt-1"></div>
        </div>

        <div class="flex items-center justify-between bg-mldark-900 p-2 rounded-xl border border-mldark-600">
            <button id="toggleQuestionBtn" onclick="setQuestionViewMode('question')" class="flex-1 py-2 px-4 rounded-lg font-rajdhani font-bold text-xs sm:text-sm transition-all bg-gradient-to-r from-mlgold-600 to-mlgold-500 text-mldark-900 flex items-center justify-center space-x-2 shadow-md">
                <i class="fa-solid fa-file-lines"></i>
                <span>Teks & Gambar Soal</span>
            </button>
            <div class="w-2"></div>
            <button id="toggleOptionsBtn" onclick="setQuestionViewMode('options')" class="flex-1 py-2 px-4 rounded-lg font-rajdhani font-bold text-xs sm:text-sm transition-all bg-mldark-800 text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-2">
                <i class="fa-solid fa-list-check"></i>
                <span>Pilihan Opsi Jawaban (Klik untuk Membuka)</span>
            </button>
        </div>

        <div id="questionContainer" class="ml-card rounded-2xl p-6 protected-text space-y-4">
            <div id="questionImageWrapper" class="hidden flex flex-col items-center justify-center bg-mldark-900/90 p-3 rounded-xl border border-mlgold-500/30">
                <img id="questionImage" src="" alt="Gambar Soal" onclick="openImageZoomModal(this.src)" class="max-h-72 w-auto object-contain rounded-lg cursor-zoom-in shadow-lg border border-mldark-600 hover:border-mlgold-400 transition-all" onerror="handleImageLoadError(this)">
                <span class="text-[11px] text-mlgold-400/80 font-rajdhani mt-2 flex items-center gap-1">
                    <i class="fa-solid fa-magnifying-glass-plus"></i> Klik gambar untuk memperbesar
                </span>
            </div>

            <p id="questionText" class="text-base sm:text-lg font-medium text-slate-100 leading-relaxed select-none">
                Memuat teks soal...
            </p>
        </div>

        <div id="optionsContainer" class="ml-card rounded-2xl p-6 hidden">
            <h3 id="optionsTitle" class="text-xs font-rajdhani font-bold text-mlgold-400 uppercase tracking-wider mb-3">Pilihan Opsi Jawaban:</h3>
            
            <div id="optionsList" class="space-y-3"></div>

            <div id="essayArea" class="hidden space-y-3">
                <textarea id="essayInput" rows="5" oninput="saveCurrentEssayAnswer()" class="w-full p-4 rounded-xl bg-mldark-900 border border-mldark-600 focus:border-mlgold-400 focus:ring-1 focus:ring-mlgold-400 text-slate-100 text-sm transition-all" placeholder="Tuliskan jawaban essay Anda secara lengkap dan lugas di sini..."></textarea>
                <p class="text-xs text-slate-400"><i class="fa-solid fa-circle-info mr-1 text-mlgold-400"></i>Jawaban essay akan dievaluasi dan dinilai oleh Guru.</p>
            </div>
        </div>

        <div id="actionControlsContainer" class="ml-card p-4 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-3">
            <div id="autoAdvanceNotice" class="text-xs text-slate-400 font-medium flex items-center gap-1.5">
                <i class="fa-solid fa-circle-info text-mlblue-400"></i>
                <span id="navInfoText">Gunakan tombol di atas untuk melihat soal atau membuka opsi jawaban.</span>
            </div>

            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-end">
                <button id="prevQuestionBtn" onclick="navigateGlobalPrev()" class="px-4 py-2.5 bg-mldark-800 hover:bg-mldark-700 text-slate-300 font-rajdhani font-bold rounded-xl text-sm transition-all flex items-center justify-center space-x-2 border border-mldark-600">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                    <span>SEBELUMNYA</span>
                </button>

                <button id="flagQuestionBtn" onclick="toggleFlagCurrentQuestion()" class="px-4 py-2.5 bg-amber-950/50 hover:bg-amber-900/50 text-amber-300 font-rajdhani font-bold rounded-xl text-sm transition-all flex items-center justify-center space-x-2 border border-amber-500/40">
                    <i id="flagQuestionIcon" class="fa-regular fa-bookmark text-xs"></i>
                    <span id="flagQuestionText">RAGU-RAGU</span>
                </button>

                <button id="nextQuestionBtn" onclick="navigateGlobalNext()" class="px-4 py-2.5 bg-mlgold-500/20 hover:bg-mlgold-500/30 text-mlgold-300 font-rajdhani font-bold rounded-xl text-sm transition-all flex items-center justify-center space-x-2 border border-mlgold-500/40">
                    <span>SELANJUTNYA</span>
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>

                <button id="finishExamTriggerBtn" onclick="promptFinishConfirmation()" class="hidden px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-orbitron font-bold rounded-xl text-sm shadow-lg transition-all flex items-center justify-center space-x-2 border border-emerald-400">
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                    <span>SUBMIT VICTORY</span>
                </button>
            </div>
        </div>
    </section>

    <!-- RESULTS & REFLECTION VIEW -->
    <section id="resultsView" class="hidden max-w-2xl mx-auto space-y-6">
        <div class="ml-card rounded-2xl p-6 sm:p-8 text-center space-y-6 shadow-2xl relative border-mlgold-400/50">
            <div class="inline-flex p-4 rounded-full bg-mlgold-500/15 border border-mlgold-400 text-mlgold-400 text-5xl mb-1 shadow-lg shadow-mlgold-500/25">
                <i class="fa-solid fa-crown"></i>
            </div>

            <div>
                <h2 class="font-orbitron text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-mlgold-300 via-mlgold-400 to-mlgold-500">VICTORY!</h2>
                <p id="studentResultGreeting" class="text-sm text-slate-300 font-rajdhani text-base mt-1">Terima kasih telah bertanding dengan sportif!</p>
            </div>

            <div class="bg-mldark-900/90 p-6 rounded-2xl border border-mlgold-500/30">
                <span class="text-xs uppercase font-rajdhani font-bold text-mlgold-400 tracking-widest" id="scoreTypeLabel">Skor Poin Soal Objektif</span>
                <div id="scoreDisplay" class="font-orbitron text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-mlgold-300 to-mlblue-400 my-2">0/100</div>
                <p id="essayPendingNotice" class="text-xs text-amber-300 bg-amber-950/60 p-2 rounded-lg border border-amber-500/30 mt-2">
                    <i class="fa-solid fa-hourglass-half mr-1"></i>Data berhasil disinkronkan ke Google Sheets via Apps Script.
                </p>
            </div>

            <div id="encouragementBox" class="p-4 rounded-xl bg-mlgold-500/10 text-mlgold-300 font-semibold text-base border border-mlgold-500/30 font-rajdhani text-lg">
                "EPIC COMEBACK! Terus tingkatkan prestasimu!"
            </div>

            <!-- SECTION REFLEKSI SISWA -->
            <div class="p-5 bg-purple-950/40 rounded-2xl border border-purple-500/30 text-left space-y-3 shadow-md">
                <div class="flex items-center space-x-2 text-purple-300 font-rajdhani font-bold text-base">
                    <i class="fa-solid fa-comments text-purple-400 text-lg"></i>
                    <span>Refleksi Pembelajaran Siswa</span>
                </div>
